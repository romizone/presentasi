# OpenRouter
OPENROUTER_API_KEY=
APP_URL=http://localhost:3000

# Model — verifikasi slug lewat /api/v1/models sebelum dipakai
MODEL_PLANNER=deepseek/deepseek-v4-pro-0813
MODEL_WRITER=deepseek/deepseek-v4.1-flash
MODEL_IMAGE=bytedance-seed/seedream-4.5

# Alias lama (opsional). Router membaca MODEL_* dulu.
OPENROUTER_MODEL_STRATEGIST=
OPENROUTER_MODEL_IMAGE=
OPENROUTER_MODEL_IMAGE_FALLBACK=

# Batas operasional
IMAGE_CONCURRENCY=4
MAX_SLIDES=30
COST_CEILING_USD=2.00
